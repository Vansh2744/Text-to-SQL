# Backend base URL (public, contains no secrets)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Local development without Clerk: sent as X-Dev-User (backend must run with AUTH_MODE=dev)
NEXT_PUBLIC_DEV_USER=dev-user
# Set both to enable Clerk sign-in (then the dev user is not used)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
