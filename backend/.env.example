APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://querypilot:querypilot@localhost:5432/querypilot

# "dev" = X-Dev-User header (local only, refused when APP_ENV=production); "clerk" = verify Clerk JWTs
AUTH_MODE=dev
CLERK_ISSUER=
CLERK_JWKS_URL=

LLM_PROVIDER=groq
GROQ_API_KEY=
# Pick a currently supported model from Groq's docs
GROQ_MODEL=

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
MAX_COLUMNS=200
QUERY_TIMEOUT_SECONDS=15
MAX_RESULT_ROWS=1000
MAX_CONCURRENT_QUERIES=4
DUCKDB_MEMORY_LIMIT=512MB
DUCKDB_THREADS=2
SQL_RETRY_LIMIT=1
RATE_LIMIT_PER_MINUTE=30
